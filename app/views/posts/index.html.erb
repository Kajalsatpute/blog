<div class="container">
  <h1>Posts</h1>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>Title</th>
        <th>Description</th>
        <th>TagList</th>
        <th>User</th>
        <th>Post</th>
      </tr>
    </thead>

    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td><%= post.title %></td>
          <td><%= post.description %></td>
          <td><%= post.tag_list %></td>
          <td><%= post.user.email %></td>
          <td><%= link_to 'Show', post, class: "btn btn-primary btn-sm" %></td>
          <td><%= link_to 'Edit', edit_post_path(post), class: "btn btn-secondary btn-sm" %></td>
          <td>
          <%= link_to 'Destroy', post_path(post), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-xs btn-primary" %></td>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <br>

  <%= link_to "New post", new_post_path, class: "btn btn-success" %>
</div>
