<div class="container">
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">Post Details</h5>

      <p class="card-text"><strong>Title:</strong> <%= @post.title %></p>

      <p class="card-text"><strong>Description:</strong> <%= @post.description %></p>

      <p class="card-text"><strong>Tag List:</strong> <%= @post.tag_list %></p>

      <p class="card-text"><strong>Images:</strong> 
        <% @post.images.each do |image| %>
          <%= image_tag image.variant(resize_to_limit: [500, 500]) %>
        <% end %>
      </p>

      <%= link_to 'Edit', edit_post_path(@post), class: "btn btn-secondary mr-2" %>
      <%= link_to 'Back', posts_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
